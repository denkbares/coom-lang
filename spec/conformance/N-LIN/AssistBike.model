product {
    AssistBike assistBike
}

structure AssistBike {
    num /kmh assistSpeed
    num /W   motorPower
}

// The implication would satisfy its own condition, which is no reason for the value.
behavior AssistBike {
    condition assistSpeed > 0
    imply assistSpeed = 25
}

behavior AssistBike {
    imply motorPower = assistSpeed * 10
}
