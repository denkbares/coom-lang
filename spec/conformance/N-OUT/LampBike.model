product {
    LampBike lampBike
}

structure LampBike {
    LightMode  mode
    num /lm    lumen
}

enumeration LightMode { Eco; Boost }

// Both implications write the same slot, so the condition of the second one cannot hold.
behavior LampBike {
    imply lumen = 200

    condition mode = Boost
    imply lumen = 400
}
